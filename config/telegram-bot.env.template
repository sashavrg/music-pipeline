# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}

# Allowed chat id(s) — one id, or a comma/space-separated list. Every listed
# chat may issue commands and receives broadcast notifications.
# Example: TELEGRAM_ALLOWED_CHAT_ID=123456789,987654321
TELEGRAM_ALLOWED_CHAT_ID=${TELEGRAM_ALLOWED_CHAT_ID}

# Optional polling tweaks
TELEGRAM_POLL_TIMEOUT=${TELEGRAM_POLL_TIMEOUT}
TELEGRAM_POLL_WAIT=${TELEGRAM_POLL_WAIT}
