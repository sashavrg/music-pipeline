[Unit]
Description=Telegram bot for slskd album queueing
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/default/slskd-telegram-bot
ExecStart=/usr/local/bin/slskd-telegram-bot.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/slskd-telegram-bot.log
StandardError=append:/var/log/slskd-telegram-bot.log

[Install]
WantedBy=multi-user.target
