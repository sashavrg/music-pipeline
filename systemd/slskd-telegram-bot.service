[Unit]
Description=Telegram bot for slskd album queueing
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/default/slskd-telegram-bot
EnvironmentFile=-/etc/music-pipeline.env
ExecStart=/usr/local/bin/slskd-telegram-bot
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=slskd-telegram-bot

[Install]
WantedBy=multi-user.target
