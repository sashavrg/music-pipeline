# ─── Secrets (required) ────────────────────────────────────────────────────────
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram user/chat ID (only this ID can send commands to the bot)
TELEGRAM_ALLOWED_CHAT_ID=

# Discogs API token (https://www.discogs.com/settings/developers)
DISCOGS_USER_TOKEN=

# Plex token (https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/)
PLEX_TOKEN=

# Soulseek credentials
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=

# slskd web UI credentials — DO NOT use the default `slskd`/`slskd`.
# Generate strong values, e.g. `openssl rand -base64 24`.
SLSKD_WEB_USERNAME=
SLSKD_WEB_PASSWORD=

# slskd metrics endpoint credentials (used when /metrics is exposed).
SLSKD_METRICS_USERNAME=
SLSKD_METRICS_PASSWORD=


# ─── Plex config ───────────────────────────────────────────────────────────────
PLEX_HOST=localhost
PLEX_PORT=32400
PLEX_LIBRARY_NAME=Music


# ─── Paths ─────────────────────────────────────────────────────────────────────
# Where beets config/db lives
BEETS_CONFIG_DIR=/root/.config/beets

# Root of the music library (beets moves imported files here)
MUSIC_LIBRARY_ROOT=/mnt/storage/share/media/music/music

# Where slskd deposits completed downloads
SLSKD_COMPLETE_DIR=/mnt/scratch/slskd/complete

# Staging area: settled & validated downloads waiting for beets import
SLSKD_READY_DIR=/mnt/scratch/slskd/ready

# Albums with chromaprint crashes or quality issues land here
SLSKD_QUARANTINE_DIR=/mnt/scratch/slskd/quarantine

# slskd config file location (Docker volume mount path on host)
SLSKD_CONFIG_DIR=/home/docker/slskd


# ─── Telegram bot tuning (optional) ───────────────────────────────────────────
TELEGRAM_POLL_TIMEOUT=45
TELEGRAM_POLL_WAIT=2


# ─── Notes ─────────────────────────────────────────────────────────────────────
# Path variables above configure where install.sh writes configs.
# The Python scripts themselves also hardcode these same paths at the top of
# each file. If you change paths from defaults, update the constants in:
#   scripts/beets-quality-upgrade.py  (LIB_DB, LIB_ROOT, QUARANTINE_*)
#   scripts/slskd-recover.py          (SLSKD_URL, LIBRARY_ROOT, BEETS_DB)
#   scripts/slskd-promote-ready.py    (SRC, DST)
